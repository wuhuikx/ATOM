# AtomRL release dependencies validated on MI355X (gfx950).
#
# Sourced by release/build_image.sh so release images use these exact versions.
#
# Validated: 2026-11-19 on 2 x 8x MI355X (gfx950), ROCm 7.2, vLLM 0.23.0: the image
# built from ATOM 2a5440e5b with these pins, published as
# rocm/atom-dev:atomrl-dapo-gfx950-rocm7.2.3-261119 (sha256:ced66f1525e7...),
# passed examples/run.sh's t0, t1 and t2 tiers. See release/VALIDATION.md.
#
# AITER moved from ff745fb09 to 2037a7711 on 2026-11-19 for ROCm/aiter#7640 (MoE sorting
# pad ids), and flydsl from 0.4.2 to the 0.5.0 that AITER pins.

# ATOM, AtomRL, and Lumen are installed from the current repository checkout.
# AITER and MORI are pinned to verified commits in their official ROCm repos.
AITER_REPO=https://github.com/ROCm/aiter.git
AITER_SHA=2037a7711885f26acd5683fcde0200a5588e595f
MORI_REPO=https://github.com/ROCm/mori.git
# The sdma-new line (Lumen's third_party/mori pin), not on any ROCm/mori branch:
# a clone cannot check it out, so the Dockerfiles fetch it by SHA.
MORI_SHA=9c42e3240b33359331b2cf2141b28886055da583

# --- Base image and the pinned python deps that differ from it ---
BASE_IMAGE=vllm/vllm-openai-rocm:v0.23.0
# The base image ships flydsl 0.1.4.2; the pinned AITER source pins 0.5.0. This is
# the single most common upgrade failure. Its setup.py also installs the ROCm
# Triton it pins (via .github/scripts/install_triton.sh), replacing the base
# image's 3.6.0.
FLYDSL_VERSION=0.5.0
# NVIDIA upstream. MORI-EP needs the ROCm fork instead -- see 08-release.md 8.1.2.
MEGATRON_CORE_VERSION=0.18.2
APEX_SHA=daed85255d51476425080e7e6203f0bee6d7e4cc
TE_SHA=6e541a10419a6e31bdc98b1516db04eb81a463b6
