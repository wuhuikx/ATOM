# Build docker/Dockerfile as rocm/atom-dev:latest before this image.
# Override with --build-arg BASE_IMAGE=... as needed.
ARG BASE_IMAGE=rocm/atom-dev:latest
FROM ${BASE_IMAGE}

WORKDIR /opt/atomrl

# ─── System build dependencies ───────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git ninja-build cmake \
        libopenmpi-dev libibverbs-dev rdma-core libpci-dev \
        vim curl wget htop && \
    rm -rf /var/lib/apt/lists/*

# Copy the current ATOM checkout, including AtomRL and in-tree Lumen.
COPY . /opt/atomrl/ATOM

# ATOM uses the SPDX license string form, supported by setuptools 77+.
RUN pip install --upgrade "setuptools>=77"

# Install Lumen development dependencies explicitly.
RUN pip install -r /opt/atomrl/ATOM/atomrl/lumen/requirements.txt

# Install ATOM and AtomRL as separate distributions. The AtomRL package owns
# its RL-only dependencies (Ray and OmegaConf); they must not enter atom.
RUN pip install datasets "math_verify[antlr4_13_2]" \
        safetensors accelerate pytest pytest-xdist ruff mypy && \
    cd /opt/atomrl/ATOM && \
    pip install --no-build-isolation --no-deps -e . && \
    LUMEN_BUILD_EXTENSIONS=1 pip install --no-build-isolation -e ./atomrl

# ─── torchao ─────────────────────────────────────────────────────────────────
RUN pip install 'torchao>=0.8,<0.10'

# ─── Megatron-LM-AMD ────────────────────────────────────────────────────────
ARG MEGATRON_COMMIT=8dd45f5a51378ec1ee7937dee3c20d8626df4763
RUN git clone --recursive https://github.com/ROCm/Megatron-LM.git /opt/atomrl/megatron_lm && \
    cd /opt/atomrl/megatron_lm && git checkout ${MEGATRON_COMMIT} && \
    pip install -e . -U --force-reinstall --no-deps && \
    cd megatron/core/datasets && make

# ─── PYTHONPATH ──────────────────────────────────────────────────────────────
ENV RL_ROOT="/opt/atomrl"
ENV ATOM_DIR="/opt/atomrl/ATOM"
ENV AITER_DIR="/app/aiter-test"
ENV PYTHONPATH="/opt/atomrl/megatron_lm:/opt/atomrl/ATOM:/app/aiter-test:/opt/atomrl/ATOM/atomrl:${PYTHONPATH:-}"

# ─── Runtime env (override HIP_VISIBLE_DEVICES at container launch) ─────────
ENV MORI_ENABLE_SDMA=1
ENV VLLM_USE_V1=1
ENV TORCHDYNAMO_DISABLE=1

# ─── ATOM/vLLM attention backend ────────────────────────────────────────────
ENV VLLM_ROCM_ATTN_BACKEND="ROCM_AITER_FA"
ENV VLLM_ROCM_ATTN_BACKEND_FALLBACK="ROCM_AITER_UNIFIED_ATTN"

RUN python -c "import torch, pathlib; print(pathlib.Path(torch.__file__).parent / 'lib')" \
        > /etc/ld.so.conf.d/torch.conf && ldconfig

WORKDIR /opt/atomrl/ATOM/atomrl

CMD ["/bin/bash"]
